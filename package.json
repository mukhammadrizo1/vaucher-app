    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.8",
    "@types/file-saver": "^2.0.7",
    "bootstrap": "^5.3.8",
    "buffer": "^6.0.3",
    "docx": "^8.5.0",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.7.0",
    "html-to-docx": "^1.8.0",
