{
  "name": "vaucher-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Vaucher App - Angular Frontend and NestJS Backend with Neon Database",
  "scripts": {
    "start:backend": "npm --prefix backend run start:dev",
    "start:frontend": "npm --prefix frontend start",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:push": "npm --prefix backend run prisma:push",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "angular",
    "nestjs",
    "neon",
    "postgres",
    "prisma",
    "vouchers",
    "contracts"
  ],
  "author": "",
  "license": "ISC"
}
